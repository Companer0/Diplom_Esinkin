Функция СоздатьРеализации(Период) Экспорт

	НачалоПериода = НачалоМесяца(Период);
	КонецПериода = КонецМесяца(Период);

	Результаты = Новый Массив;
	МассивДоговоров = Новый Массив;

	// 1. Получаем действующие абонентские договоры.

	ЗапросДоговоров = Новый Запрос;
	ЗапросДоговоров.Текст =
	"ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Договор
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
	|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора";

	ЗапросДоговоров.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.ВКМ_Абонент);

	ВыборкаДоговоров = ЗапросДоговоров.Выполнить().Выбрать();

	Пока ВыборкаДоговоров.Следующий() Цикл

		МассивДоговоров.Добавить(ВыборкаДоговоров.Договор);

	КонецЦикла;

	// Если подходящих договоров нет, завершаем выполнение.

	Если МассивДоговоров.Количество() = 0 Тогда
		Возврат Результаты;
	КонецЕсли;

	// 2. Одним запросом получаем существующие реализации.

	СоответствиеРеализаций = Новый Соответствие;

	ЗапросРеализаций = Новый Запрос;
	ЗапросРеализаций.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Договор КАК Договор,
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Договор В (&МассивДоговоров)
	|	И РеализацияТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления";

	ЗапросРеализаций.УстановитьПараметр("МассивДоговоров", МассивДоговоров);

	ЗапросРеализаций.УстановитьПараметр("НачалоПериода", НачалоПериода);

	ЗапросРеализаций.УстановитьПараметр("КонецПериода", КонецПериода);

	ВыборкаРеализаций = ЗапросРеализаций.Выполнить().Выбрать();

	Пока ВыборкаРеализаций.Следующий() Цикл

		Если СоответствиеРеализаций.Получить(
		ВыборкаРеализаций.Договор) = Неопределено Тогда

			СоответствиеРеализаций.Вставить(
			ВыборкаРеализаций.Договор, ВыборкаРеализаций.Ссылка);

		КонецЕсли;

	КонецЦикла;

	// 3. Обрабатываем каждый договор.

	Для Каждого Договор Из МассивДоговоров Цикл

		Итог = Новый Структура;
		
		Итог.Вставить("Контрагент", Договор.Владелец);
		Итог.Вставить("Договор", Договор);
		Итог.Вставить("Реализация", Документы.РеализацияТоваровУслуг.ПустаяСсылка());
		Итог.Вставить("Состояние", "");
		Итог.Вставить("ОписаниеОшибки", "");
		
		
		Попытка

			// Проверяем наличие реализации.

			СуществующаяРеализация = СоответствиеРеализаций.Получить(Договор);

			Если СуществующаяРеализация <> Неопределено Тогда

				Итог.Реализация = СуществующаяРеализация;
				Итог.Состояние = "Уже существует";

			Иначе

				// 4. Создаём новую реализацию.

				НовыйДокумент = Документы.РеализацияТоваровУслуг.СоздатьДокумент();

				НовыйДокумент.Дата = КонецПериода;
				НовыйДокумент.Контрагент = Договор.Владелец;
				НовыйДокумент.Договор = Договор;
				НовыйДокумент.Организация = Договор.Организация;

				// 5. Выполняем стандартное автозаполнение.

				ПолучитьСообщенияПользователю(Истина);

				НовыйДокумент.ВКМ_ВыполнитьАвтозаполнение();
				НовыйДокумент.СуммаДокумента = НовыйДокумент.Услуги.Итог("Сумма");
					
				// 6. Проверяем заполнение перед проведением.
				
				НовыйДокумент.ДополнительныеСвойства.Вставить("ВКМ_МассовоеСозданиеАктов", Истина);

				Если НовыйДокумент.ПроверитьЗаполнение() Тогда

					НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);

					Итог.Реализация = НовыйДокумент.Ссылка;
					Итог.Состояние = "Создана и проведена";

				Иначе

					МассивСообщений =
						ПолучитьСообщенияПользователю(Истина);

					МассивТекстовОшибок = Новый Массив;

					Для Каждого Сообщение Из МассивСообщений Цикл

						Если ЗначениеЗаполнено(Сообщение.Текст) Тогда

							МассивТекстовОшибок.Добавить(
								Сообщение.Текст);

						КонецЕсли;

					КонецЦикла;

					Итог.Состояние =
						"Не пройдена проверка заполнения";

					Если МассивТекстовОшибок.Количество() > 0 Тогда

						Итог.ОписаниеОшибки = СтрСоединить(МассивТекстовОшибок, "; ");

					Иначе

						Итог.ОписаниеОшибки = "Проверка заполнения не пройдена. " + "Сообщения не получены.";

					КонецЕсли;

				КонецЕсли;

			КонецЕсли;

		Исключение

			Итог.Состояние = "Ошибка: " + ОписаниеОшибки();
			Итог.ОписаниеОшибки = ОписаниеОшибки();

		КонецПопытки;

		Результаты.Добавить(Итог);

	КонецЦикла;

	Возврат Результаты;

КонецФункции

Функция НайтиРеализацию(Договор, НачалоПериода, КонецПериода)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Договор = &Договор
	|	И РеализацияТоваровУслуг.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ РеализацияТоваровУслуг.ПометкаУдаления";

	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Документы.РеализацияТоваровУслуг.ПустаяСсылка();

КонецФункции