Функция ОтправитьСообщение(ТекстСообщения) Экспорт

	// Получаем токен бота и идентификатор группы из констант.
	ТокенБота = Константы.ВКМ_ТокенУправленияТелеграмБотом.Получить();
	ИдентификаторГруппы = Константы.ВКМ_ИдентификаторГруппыДляОповещения.Получить();

	Попытка

		// Создаем защищенное HTTPS-соединение с Telegram.
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
		HTTPСоединение = Новый HTTPСоединение("api.telegram.org", 443, , , , 30, ЗащищенноеСоединение);

		// Формируем адрес ресурса.
		АдресРесурса = "/bot" + ТокенБота + "/sendMessage";

		// Создаем HTTP-запрос.
		HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);

		// Устанавливаем заголовок Content-Type.
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");

		// Формируем структуру с данными сообщения.
		ДанныеСообщения = Новый Структура;
		ДанныеСообщения.Вставить("chat_id", ИдентификаторГруппы);
		ДанныеСообщения.Вставить("text", ТекстСообщения);

		// Преобразуем структуру в JSON.
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписатьJSON(ЗаписьJSON, ДанныеСообщения);
		СтрокаJSON = ЗаписьJSON.Закрыть();

		// Устанавливаем тело HTTP-запроса.
		HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

		// Отправляем POST-запрос.
		HTTPОтвет = HTTPСоединение.ВызватьHTTPМетод("POST", HTTPЗапрос);

		// Получаем тело HTTP-ответа.
		ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

		// Проверяем код состояния HTTP-ответа.
		Если HTTPОтвет.КодСостояния <> 200 Тогда
			ТекстОшибки = "Ошибка отправки сообщения в Telegram." + Символы.ПС + "Код состояния: "
				+ Строка(HTTPОтвет.КодСостояния) + Символы.ПС + "Ответ сервера: " + ТелоОтвета;
			ЗаписьЖурналаРегистрации("Телеграм.ОшибкаОтправкиСообщения", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			Возврат Ложь;
		КонецЕсли;

		// Преобразуем JSON-ответ в структуру.
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		РезультатJSON = ПрочитатьJSON(ЧтениеJSON);

		// Проверяем результат отправки сообщения.
		УспешноОтправлено = Ложь;
		РезультатJSON.Свойство("ok", УспешноОтправлено);

		Если УспешноОтправлено Тогда
			Возврат Истина;
		Иначе
			ТекстОшибки = "Telegram не подтвердил отправку сообщения." + Символы.ПС + "Ответ сервера: " + ТелоОтвета;
			ЗаписьЖурналаРегистрации("Телеграм.ОшибкаОтправкиСообщения", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
			Возврат Ложь;
		КонецЕсли;

	Исключение

		// Регистрируем ошибки соединения и выполнения запроса.
		ЗаписьЖурналаРегистрации("Телеграм.ОшибкаСоединения", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		Возврат Ложь;

	КонецПопытки;

КонецФункции