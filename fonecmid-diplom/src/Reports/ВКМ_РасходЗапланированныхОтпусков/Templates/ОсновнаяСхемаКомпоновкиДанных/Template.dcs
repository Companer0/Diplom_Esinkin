<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДнейПлан</dataPath>
			<field>ДнейПлан</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДнейФакт</dataPath>
			<field>ДнейФакт</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	План.Сотрудник КАК Сотрудник,
	СУММА(РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВЫБОР
		КОГДА План.ДатаНачала &lt; &amp;НачалоПериода
			ТОГДА &amp;НачалоПериода
		ИНАЧЕ План.ДатаНачала
	КОНЕЦ, ДЕНЬ), НАЧАЛОПЕРИОДА(ВЫБОР
		КОГДА План.ДатаОкончания &gt; &amp;КонецПериода
			ТОГДА &amp;КонецПериода
		ИНАЧЕ План.ДатаОкончания
	КОНЕЦ, ДЕНЬ), ДЕНЬ) + 1) КАК ДнейПлан
ПОМЕСТИТЬ ВТ_План
ИЗ
	РегистрСведений.ВКМ_ЗапланированныеОтпуска КАК План
ГДЕ
	План.ДатаНачала &lt;= &amp;КонецПериода
	И План.ДатаОкончания &gt;= &amp;НачалоПериода
СГРУППИРОВАТЬ ПО
	План.Сотрудник
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Начисления.Сотрудник КАК Сотрудник,
	СУММА(РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(ВЫБОР
		КОГДА Начисления.ПериодДействияНачало &lt; &amp;НачалоПериода
			ТОГДА &amp;НачалоПериода
		ИНАЧЕ Начисления.ПериодДействияНачало
	КОНЕЦ, ДЕНЬ), НАЧАЛОПЕРИОДА(ВЫБОР
		КОГДА Начисления.ПериодДействияКонец &gt; &amp;КонецПериода
			ТОГДА &amp;КонецПериода
		ИНАЧЕ Начисления.ПериодДействияКонец
	КОНЕЦ, ДЕНЬ), ДЕНЬ) + 1) КАК ДнейФакт
ПОМЕСТИТЬ ВТ_Факт
ИЗ
	РегистрРасчета.ВКМ_ОсновныеНачисления КАК Начисления
ГДЕ
	Начисления.ВидРасчета = ЗНАЧЕНИЕ(ПланВидовРасчета.ВКМ_ОсновныеНачисления.Отпускные)
	И Начисления.ПериодДействияНачало &lt;= &amp;КонецПериода
	И Начисления.ПериодДействияКонец &gt;= &amp;НачалоПериода
СГРУППИРОВАТЬ ПО
	Начисления.Сотрудник
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Пользователи.Ссылка КАК Ссылка,
	ЕСТЬNULL(ВТ_План.ДнейПлан, 0) КАК ДнейПлан,
	ЕСТЬNULL(ВТ_Факт.ДнейФакт, 0) КАК ДнейФакт
ИЗ
	Справочник.Пользователи КАК Пользователи
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_План КАК ВТ_План
		ПО Пользователи.Ссылка = ВТ_План.Сотрудник
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Факт КАК ВТ_Факт
		ПО Пользователи.Ссылка = ВТ_Факт.Сотрудник
ГДЕ
	Пользователи.Наименование &lt;&gt; "ОтправкаСерверныхОповещений"
	И Пользователи.Наименование &lt;&gt; "&lt;Не указан&gt;"</query>
	</dataSet>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>true</useRestriction>
		<expression>&amp;СтандартныйПериод.ДатаНачала</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<useRestriction>true</useRestriction>
		<expression>&amp;СтандартныйПериод.ДатаОкончания</expression>
		<availableAsField>false</availableAsField>
	</parameter>
	<parameter>
		<name>СтандартныйПериод</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Стандартный период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>v8:StandardPeriod</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>false</useRestriction>
	</parameter>
	<template>
		<name>Макет1</name>
		<template xmlns:dcsat="http://v8.1c.ru/8.1/data-composition-system/area-template" xsi:type="dcsat:AreaTemplate">
			<dcsat:item xsi:type="dcsat:TableRow">
				<dcsat:tableCell/>
			</dcsat:item>
