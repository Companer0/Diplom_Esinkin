
&НаКлиенте
Процедура ОткрытьАнализГрафика(Команда)

    // 1. Собираем данные из табличной части в массив структур
    ОтпускиСотрудников = Новый Массив;
    
    Для Каждого СтрокаТЧ Из Объект.ОтпускаСотрудников Цикл
    	
        Если ЗначениеЗаполнено(СтрокаТЧ.Сотрудник) 
            И ЗначениеЗаполнено(СтрокаТЧ.ДатаНачала) 
            И ЗначениеЗаполнено(СтрокаТЧ.ДатаОкончания) Тогда
            
            ДанныеСотрудника = Новый Структура;
            ДанныеСотрудника.Вставить("Сотрудник", СтрокаТЧ.Сотрудник);
            ДанныеСотрудника.Вставить("ДатаНачала", СтрокаТЧ.ДатаНачала);
            ДанныеСотрудника.Вставить("ДатаОкончания", СтрокаТЧ.ДатаОкончания);
            
            ОтпускиСотрудников.Добавить(ДанныеСотрудника);
            
        КонецЕсли; 
        
    КонецЦикла;
    
    // 2. Помещаем данные во временное хранилище на сервере
    АдресХранилища = ПоместитьДанныеВоВременноеХранилищеСервер(ОтпускиСотрудников);
    
    // 3. Передаем адрес и год в параметры и открываем форму
    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("АдресХранилища", АдресХранилища);
    ПараметрыФормы.Вставить("Год", Объект.Год);
    
    ОткрытьФорму("Документ.ВКМ_ГрафикОтпусков.Форма.АнализГрафика", ПараметрыФормы, ЭтотОбъект);
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоместитьДанныеВоВременноеХранилищеСервер(МассивДанных)
    Возврат ПоместитьВоВременноеХранилище(МассивДанных);
КонецФункции

&НаКлиенте
Процедура ОтпускаСотрудниковДатаОкончанияПриИзменении(Элемент)
	РассчитатьПревышениеДнейОтпуска();
КонецПроцедуры

&НаКлиенте
Процедура ОтпускаСотрудниковДатаНачалаПриИзменении(Элемент)
	РассчитатьПревышениеДнейОтпуска();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПревышениеДнейОтпуска()

    СоответствиеДней = Новый Соответствие;
    
     Для Каждого СтрокаТЧ Из Объект.ОтпускаСотрудников Цикл
     	
        Если ЗначениеЗаполнено(СтрокаТЧ.Сотрудник) 
        
            И ЗначениеЗаполнено(СтрокаТЧ.ДатаНачала) 
            И ЗначениеЗаполнено(СтрокаТЧ.ДатаОкончания) 
            И СтрокаТЧ.ДатаОкончания >= СтрокаТЧ.ДатаНачала Тогда
            
             Дни = (СтрокаТЧ.ДатаОкончания - СтрокаТЧ.ДатаНачала) / 86400 + 1;
            
            ТекущаяСумма = ?(СоответствиеДней.Получить(СтрокаТЧ.Сотрудник) = Неопределено, 0, СоответствиеДней.Получить(СтрокаТЧ.Сотрудник));
            СоответствиеДней.Вставить(СтрокаТЧ.Сотрудник, ТекущаяСумма + Дни);
            
        КонецЕсли;
        
    КонецЦикла;
    
    Для Каждого СтрокаТЧ Из Объект.ОтпускаСотрудников Цикл
    	
        СуммаДней = СоответствиеДней.Получить(СтрокаТЧ.Сотрудник);
        СтрокаТЧ.Превышает28Дней = (СуммаДней <> Неопределено И СуммаДней > 28);
        
    КонецЦикла;
    
КонецПроцедуры