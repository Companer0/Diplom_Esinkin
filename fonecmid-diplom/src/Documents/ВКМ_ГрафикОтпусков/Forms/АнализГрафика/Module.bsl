&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АдресХранилища") И ЗначениеЗаполнено(Параметры.АдресХранилища) Тогда

		МассивДанных = ПолучитьИзВременногоХранилища(Параметры.АдресХранилища);
		ГодДокумента = Параметры.Год;
		Объект.Год  = ГодДокумента;

		ЗаполнитьДиаграмму(МассивДанных, ГодДокумента);

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДиаграмму(МассивДанных, ГодДокумента)

	Диаграмма.Очистить();

	Диаграмма.АвтоОпределениеПолногоИнтервала = Ложь;
	Диаграмма.УстановитьПолныйИнтервал(Дата(ГодДокумента, 1, 1), КонецГода(Дата(ГодДокумента, 1, 1)));
    
//    Диаграмма.ЗаголовокТочек = "Сотрудник";
    
    // Настройка шкалы времени
	ШкалаВремени = Диаграмма.ОбластьПостроения.ШкалаВремени;

	ШкалаВремени.Положение = ПоложениеШкалыВремени.Верх;

	ЭлементыШкалыВремени = ШкалаВремени.Элементы;

	// Первый уровень — месяцы
	ЭлементШкалы = ЭлементыШкалыВремени[0];
	ЭлементШкалы.Единица = ТипЕдиницыШкалыВремени.Месяц;
	ЭлементШкалы.Формат = "ДФ='ММММ'";

	// Второй уровень — дни недели
	ЭлементШкалы = ЭлементыШкалыВремени.Добавить();
	ЭлементШкалы.Единица = ТипЕдиницыШкалыВремени.Неделя;
	ЭлементШкалы.ОтображатьПериодическиеМетки = Ложь;

	// Добавляем номера недель
	НачалоГода = Дата(ГодДокумента, 1, 1);
	КонецГодаДиаграммы = КонецГода(НачалоГода);
	ДатаМетки = НачалоГода;

	Пока ДатаМетки <= КонецГодаДиаграммы Цикл

		Метка = ЭлементШкалы.Метки.Добавить(ДатаМетки);
		Метка.Текст = Строка(НеделяГода(ДатаМетки));

		Если ДатаМетки = НачалоГода Тогда
			ДатаМетки = ДатаМетки + (8 - ДеньНедели(НачалоГода)) * 86400;
		Иначе
			ДатаМетки = ДатаМетки + 7 * 86400;
		КонецЕсли;

	КонецЦикла;

	Серия = Диаграмма.УстановитьСерию("Отпуск");
	Серия.Текст = "Отпуск";

	Для Каждого СтрДанных Из МассивДанных Цикл

		ИмяСотрудника = Строка(СтрДанных.Сотрудник);

		Точка = Диаграмма.УстановитьТочку(СтрДанных.Сотрудник);
		Точка.Текст = ИмяСотрудника;

		ЗначениеДиаграммы = Диаграмма.ПолучитьЗначение(Точка, Серия);
		Интервал = ЗначениеДиаграммы.Добавить();

		Интервал.Начало = СтрДанных.ДатаНачала;
		Интервал.Конец = КонецДня(СтрДанных.ДатаОкончания);

	КонецЦикла;

КонецПроцедуры