&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АдресХранилища") И ЗначениеЗаполнено(Параметры.АдресХранилища) Тогда
		МассивДанных = ПолучитьИзВременногоХранилища(Параметры.АдресХранилища);
		ГодДокумента = ?(Параметры.Свойство("Год") И ЗначениеЗаполнено(Параметры.Год), Параметры.Год, Год(
			ТекущаяДата()));

		ЗаполнитьДиаграмму(МассивДанных, ГодДокумента);

	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДиаграмму(МассивДанных, ГодДокумента)

    Диаграмма.Очистить();

    Диаграмма.АвтоОпределениеПолногоИнтервала = Ложь;
    Диаграмма.УстановитьПолныйИнтервал(
        Дата(ГодДокумента, 1, 1),
        КонецГода(Дата(ГодДокумента, 1, 1)));

    Серия = Диаграмма.УстановитьСерию("Отпуск");

    Для Каждого СтрДанных Из МассивДанных Цикл

        ИмяСотрудника = Строка(СтрДанных.Сотрудник);

        Точка = Диаграмма.УстановитьТочку(СтрДанных.Сотрудник);
        Точка.Текст = ИмяСотрудника;

        ЗначениеДиаграммы = Диаграмма.ПолучитьЗначение(Точка, Серия);
        Интервал = ЗначениеДиаграммы.Добавить();

        Интервал.Начало = СтрДанных.ДатаНачала;
        Интервал.Конец = КонецДня(СтрДанных.ДатаОкончания);

    КонецЦикла;

КонецПроцедуры