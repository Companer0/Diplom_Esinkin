
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ВКМ_ОбслуживаниеКлиента" Тогда		
		ОбновитьПланировщик();		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПередСозданием(Элемент, Начало, Конец, ЗначенияИзмерений, Текст, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;

    ЗначенияЗаполнения = Новый Структура;
	
    // Время начала и окончания (тип Строка).
    ЗначенияЗаполнения.Вставить("ВремяНачалаРаботПлан", Формат(Начало, "ДФ=ЧЧ:мм"));
    ЗначенияЗаполнения.Вставить("ВремяОкончанияРаботПлан", Формат(Конец, "ДФ=ЧЧ:мм"));

    // Дата проведения работ.
    ЗначенияЗаполнения.Вставить("ДатаПроведенияРабот", НачалоДня(Начало));

    // Специалист из измерения Планировщика.
    ЗначенияЗаполнения.Вставить("Специалист", ЗначенияИзмерений.Получить("Специалист"));

    ПараметрыФормы = Новый Структура;
    ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);

    ОткрытьФорму("Документ.ВКМ_ОбслуживаниеКлиента.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ОбновитьПланировщик();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода = КонецМесяца(ТекущаяДатаСеанса());

	Планировщик.ТекущиеПериодыОтображения.Добавить(НачалоПериода, КонецПериода);
	
	ОбновитьПланировщик()

КонецПроцедуры

&НаСервере
Процедура ОбновитьПланировщик()
	
	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода = КонецМесяца(ТекущаяДатаСеанса());
	
	Планировщик.Элементы.Очистить();
	Планировщик.Измерения.Очистить();

	Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.ВремяНачалаИКонца;
	Измерение = Планировщик.Измерения.Добавить("Специалист");

	ОбслуживанияКлиентов = Документы.ВКМ_ОбслуживаниеКлиента.Выбрать(НачалоПериода, КонецПериода);
	
	// Специалисты
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Специалист
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	НЕ Пользователи.ПометкаУдаления
	|	И Пользователи.ВКМ_Специалист = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пользователи.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ЭлементИзмерения = Измерение.Элементы.Добавить(Выборка.Специалист);
		ЭлементИзмерения.Текст = Строка(Выборка.Специалист);

	КонецЦикла;

	// Документы
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбслуживаниеКлиента.ДатаПроведенияРабот КАК ДатаПроведенияРабот,
	|	ОбслуживаниеКлиента.ВремяНачалаРаботПлан КАК ВремяНачалаРаботПлан,
	|	ОбслуживаниеКлиента.ВремяОкончанияРаботПлан КАК ВремяОкончанияРаботПлан,
	|	ОбслуживаниеКлиента.Ссылка КАК Ссылка,
	|	ОбслуживаниеКлиента.Специалист КАК Специалист,
	|	ОбслуживаниеКлиента.Клиент КАК Клиент
	|ИЗ
	|	Документ.ВКМ_ОбслуживаниеКлиента КАК ОбслуживаниеКлиента
	|ГДЕ
	|	НЕ ОбслуживаниеКлиента.ПометкаУдаления
	|	И ОбслуживаниеКлиента.ДатаПроведенияРабот >= &НачалоПериода
	|	И ОбслуживаниеКлиента.ДатаПроведенияРабот <= &КонецПериода";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		СтрокаВремениНачала = СокрЛП(Выборка.ВремяНачалаРаботПлан);
		СтрокаВремениОкончания = СокрЛП(Выборка.ВремяОкончанияРаботПлан);

		// Пропускаем документы без заполненного времени.
		Если ПустаяСтрока(СтрокаВремениНачала) Или ПустаяСтрока(СтрокаВремениОкончания) Тогда
			Продолжить;
		КонецЕсли;

		МассивВремениНачала = СтрРазделить(Выборка.ВремяНачалаРаботПлан, ".,: ", Ложь);

		МассивВремениОкончания = СтрРазделить(Выборка.ВремяОкончанияРаботПлан, ".,: ", Ложь);

		ДатаНачала = Дата(Год(Выборка.ДатаПроведенияРабот), Месяц(Выборка.ДатаПроведенияРабот), День(
			Выборка.ДатаПроведенияРабот), Число(МассивВремениНачала[0]), Число(МассивВремениНачала[1]), 0);

		ДатаОкончания = Дата(Год(Выборка.ДатаПроведенияРабот), Месяц(Выборка.ДатаПроведенияРабот), День(
			Выборка.ДатаПроведенияРабот), Число(МассивВремениОкончания[0]), Число(МассивВремениОкончания[1]), 0);

		Элемент = Планировщик.Элементы.Добавить(ДатаНачала, ДатаОкончания);
		Элемент.Значение = Выборка.Ссылка;
		Элемент.Текст = Строка(Выборка.Клиент);

		ЗначенияИзмерений = Новый Соответствие;
		ЗначенияИзмерений.Вставить("Специалист", Выборка.Специалист);

		Элемент.ЗначенияИзмерений = Новый ФиксированноеСоответствие(ЗначенияИзмерений);

	КонецЦикла;
	
КонецПроцедуры