&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		Объект.Период = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеализации(Команда)

	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		ПоказатьПредупреждение( , "Укажите период.");
		Возврат;
	КонецЕсли;

	ДлительнаяОперация = НачатьСозданиеРеализацийНаСервере(НачалоМесяца(Объект.Период));

	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьРезультатСоздания", ЭтотОбъект);

	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);

	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;

	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция НачатьСозданиеРеализацийНаСервере(Период)

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);

	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Массовое создание актов";

	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения, "ВКМ_ДлительныеОперации.СоздатьРеализации", Период);

КонецФункции
&НаКлиенте
Процедура ОбработатьРезультатСоздания(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Статус = "Ошибка" Тогда

		ТекстОшибки = Результат.КраткоеПредставлениеОшибки;

		Если ЗначениеЗаполнено(Результат.ПодробноеПредставлениеОшибки) Тогда

			ТекстОшибки = ТекстОшибки + Символы.ПС + Символы.ПС + Результат.ПодробноеПредставлениеОшибки;

		КонецЕсли;

		ПоказатьПредупреждение( , ТекстОшибки);

		Возврат;

	КонецЕсли;

	Если Результат.Статус <> "Выполнено" Тогда
		Возврат;
	КонецЕсли;

	Результаты = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);

	УдалитьИзВременногоХранилища(Результат.АдресРезультата);

	Объект.ДоговорыИРеализации.Очистить();

	Для Каждого Итог Из Результаты Цикл

		НоваяСтрока = Объект.ДоговорыИРеализации.Добавить();

		НоваяСтрока.Контрагент = Итог.Контрагент;
		НоваяСтрока.Договор = Итог.Договор;
		НоваяСтрока.Реализация = Итог.Реализация;
		НоваяСтрока.Состояние = Итог.Состояние;
		НоваяСтрока.ОписаниеОшибки = Итог.ОписаниеОшибки;

	КонецЦикла;

КонецПроцедуры